{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalRecipe",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "status",
    "servings",
    "ingredients",
    "image_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "rejected"
      ]
    },
    "servings": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ingredient_id",
          "amount",
          "unit",
          "composition_status"
        ],
        "properties": {
          "ingredient_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string"
          },
          "composition_status": {
            "enum": [
              "verified",
              "unknown",
              "disputed"
            ]
          }
        }
      }
    },
    "image_status": {
      "enum": [
        "verified_licensed",
        "generated_labeled",
        "unavailable"
      ]
    },
    "cost_estimate_cents": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
